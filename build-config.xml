<?xml version='1.0' encoding='utf-8'?>
<widget id="com.nivaskirayabook.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Nivas KirayaBook</name>
    <description>Smart Landlord &amp; Tenant Rent Manager</description>
    <author email="support@nivaskirayabook.com">Nivas KirayaBook</author>
    <content src="https://nivaskirayabook.blogspot.com/" />
    <access origin="*" />
    <allow-navigation href="https://nivaskirayabook.blogspot.com/*" />
    <allow-navigation href="https://*.firebaseapp.com/*" />
    <allow-navigation href="https://*.googleapis.com/*" />
    <allow-navigation href="https://accounts.google.com/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <allow-intent href="whatsapp:*" />
    <allow-intent href="upi:*" />
    <icon src="res/icon.png" />
    <preference name="Orientation" value="portrait" />
</widget>
